{
  "name": "vscode-dreego",
  "displayName": "Dreego",
  "publisher": "Dreego",
  "description": "Syntax highlighting, snippets, configuration validation, formatting, and diagnostics for Dreego (.dreego) files",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:dreego"
  ],
  "icon": "media/dreego.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreego-stack/vscode-dreego"
  },
  "bugs": {
    "url": "https://github.com/dreego-stack/vscode-dreego/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "dreego",
    "go",
    "ssr",
    "templates",
    "html"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dreego",
        "aliases": [
          "Dreego",
          "dreego"
        ],
        "extensions": [
          ".dreego"
        ],
        "icon": {
          "light": "./media/dreego-logo.svg",
          "dark": "./media/dreego-logo.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dreego",
        "scopeName": "text.html.dreego",
        "path": "./syntaxes/dreego.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "dreego",
        "path": "./snippets/dreego.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "dreego.config.json",
        "url": "./schemas/dreego-config.schema.json"
      }
    ],
    "configurationDefaults": {
      "[dreego]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "files.trimTrailingWhitespace": true
      }
    },
    "commands": [
      {
        "command": "dreego.format",
        "title": "Dreego: Format Document"
      },
      {
        "command": "dreego.diagnose",
        "title": "Dreego: Run Diagnostics"
      },
      {
        "command": "dreego.selectDreegoCli",
        "title": "Dreego: Select Dreego CLI path"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dreego.format",
          "when": "resourceLangId == dreego"
        },
        {
          "command": "dreego.diagnose",
          "when": "resourceLangId == dreego"
        },
        {
          "command": "dreego.selectDreegoCli"
        }
      ]
    },
    "configuration": {
      "title": "Dreego",
      "properties": {
        "dreego.cliPath": {
          "type": "string",
          "default": "dreego",
          "description": "Path to the dreego CLI binary. Defaults to 'dreego' on PATH."
        },
        "dreego.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Format the active Dreego document on save."
        },
        "dreego.diagnoseOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run Dreego diagnostics on save."
        }
      }
    }
  },
  "scripts": {
    "test": "vscode-tmgrammar-snap --config tests/config/grammar-config.json 'tests/cases/*.test.dreego'",
    "test:update": "vscode-tmgrammar-snap --updateSnapshot --config tests/config/grammar-config.json 'tests/cases/*.test.dreego'"
  },
  "devDependencies": {
    "vscode-tmgrammar-test": "0.1.3"
  }
}
